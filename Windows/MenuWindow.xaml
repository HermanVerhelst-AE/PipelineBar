<Window x:Class="PipelineBar.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PipelineBar" Width="404" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource PB.Foreground}">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Vlakke knop met hover, voor kop, voet en rijen. -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PB.Foreground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PB.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PB.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PB.Pressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Background" Value="{DynamicResource PB.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource PB.Background}" />
            <Setter Property="Padding" Value="14,6" />
        </Style>

        <!-- Dunne schuifbalk die in licht en donker past. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="0,2,2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource PB.Thumb}" CornerRadius="3" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Marge rond de kaart laat ruimte voor de schaduw. -->
    <Grid Margin="12">
        <Border CornerRadius="8" Background="{DynamicResource PB.Background}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="8" BorderBrush="{DynamicResource PB.Border}" BorderThickness="1">
            <DockPanel>

                <!-- Kop -->
                <Grid DockPanel.Dock="Top" Margin="14,12,10,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeaderGlyph" FontFamily="{StaticResource Icons}" FontSize="22"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="SummaryText" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="UpdatedText" FontSize="12" Foreground="{DynamicResource PB.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="DismissAllButton" Grid.Column="2" Style="{StaticResource Flat}"
                            ToolTip="Alles negeren tot er iets verandert" Click="DismissAll_Click" Padding="8">
                        <TextBlock Text="&#xED1A;" FontFamily="{StaticResource Icons}" FontSize="14" />
                    </Button>
                    <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource Flat}"
                            ToolTip="Nu vernieuwen (F5)" Click="Refresh_Click" Padding="8">
                        <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="{StaticResource Icons}"
                                   FontSize="14" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="RefreshRotation" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Voet -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PB.Divider}" BorderThickness="0,1,0,0">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OpenAdoButton" Style="{StaticResource Flat}" Click="OpenAdo_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Azure DevOps openen" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource Flat}" Click="Settings_Click"
                                ToolTip="Instellingen (Ctrl+,)" Padding="8">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="14" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource Flat}" Click="Quit_Click"
                                ToolTip="PipelineBar afsluiten" Padding="8">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Inhoud -->
                <Border BorderBrush="{DynamicResource PB.Divider}" BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel x:Name="ProblemPanel" Margin="24" Visibility="Collapsed">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="26"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource PB.Secondary}" />
                            <TextBlock x:Name="ProblemText" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,10" Foreground="{DynamicResource PB.Secondary}" />
                            <Button Style="{StaticResource Accent}" HorizontalAlignment="Center"
                                    Content="Instellingen openen" Click="Settings_Click" />
                        </StackPanel>

                        <StackPanel x:Name="EmptyPanel" Margin="24,20" Visibility="Collapsed">
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="26"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource PB.Secondary}" />
                            <TextBlock Text="Geen recente runs" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,4" />
                            <TextBlock Text="Pas de projecten of de periode aan in Instellingen."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource PB.Secondary}" />
                        </StackPanel>

                        <ScrollViewer x:Name="ListScroll" MaxHeight="480" VerticalScrollBarVisibility="Auto"
                                      Focusable="False" Visibility="Collapsed">
                            <StackPanel Margin="0,2,0,6">
                                <ItemsControl x:Name="GroupList" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <!-- Projectkop -->
                                                <Grid Margin="14,10,14,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"
                                                               Foreground="{DynamicResource PB.Secondary}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Project}" FontSize="12"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource PB.Secondary}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FailedText}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PB.Critical}" />
                                                </Grid>
                                                <!-- Runs -->
                                                <ItemsControl ItemsSource="{Binding Runs}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button x:Name="RowButton" Style="{StaticResource Flat}" Margin="6,0"
                                                                    Padding="8,6,4,6" HorizontalContentAlignment="Stretch"
                                                                    Tag="{Binding Url}" ToolTip="{Binding Tooltip}"
                                                                    Click="Run_Click">
                                                                <Grid Opacity="{Binding Opacity}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="30" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="StateGlyph" Text="{Binding Glyph}"
                                                                               Foreground="{Binding GlyphBrush}"
                                                                               FontFamily="{StaticResource Icons}"
                                                                               FontSize="17" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="&#xE7B8;"
                                                                                       FontFamily="{StaticResource Icons}"
                                                                                       FontSize="11" Margin="0,1,5,0"
                                                                                       VerticalAlignment="Center"
                                                                                       Visibility="{Binding ReleaseVisibility}"
                                                                                       Foreground="{DynamicResource PB.Secondary}"
                                                                                       ToolTip="Release-pipeline" />
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{DynamicResource PB.Secondary}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Ago}" FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               Typography.NumeralAlignment="Tabular"
                                                                               Foreground="{DynamicResource PB.Tertiary}" />
                                                                    <!-- Verschijnt bij aanwijzen; vaste breedte zodat de tijd niet verspringt. -->
                                                                    <Button x:Name="ToggleButton" Grid.Column="3"
                                                                            Style="{StaticResource Flat}" Padding="5"
                                                                            Margin="4,0,0,0" Visibility="Hidden"
                                                                            Tag="{Binding Run}" ToolTip="{Binding ToggleTooltip}"
                                                                            Click="ToggleDismiss_Click">
                                                                        <TextBlock Text="{Binding ToggleGlyph}"
                                                                                   FontFamily="{StaticResource Icons}" FontSize="12"
                                                                                   Foreground="{DynamicResource PB.Secondary}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Button>
                                                            <DataTemplate.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMouseOver, ElementName=RowButton}" Value="True" />
                                                                        <Condition Binding="{Binding CanToggle}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="ToggleButton" Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding Pulse}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                <DoubleAnimation Storyboard.TargetName="StateGlyph"
                                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                                 From="1" To="0.35" Duration="0:0:0.9" />
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl x:Name="ErrorList" Margin="14,8,14,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                           Margin="0,1,7,0" Foreground="{DynamicResource PB.Caution}" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12"
                                                           TextWrapping="Wrap" MaxHeight="34"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PB.Caution}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
